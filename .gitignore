# test credentials
tests/.env

# Any pulled environment file, whatever it is called. The list above names
# the exact files CRA and Vercel create by default, which left a hole: a
# `vercel env pull` writes wherever it is told, and a file called stg.env or
# prod.env carrying a service-role key and a Teller certificate was neither
# ignored nor obviously dangerous in `git status`. Match the suffix, not the
# handful of names.
*.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
supabase/.temp/
tests/node_modules/
tests/test-results/
tests/playwright-report/
tests/debug-*.png
.claude/worktrees/
.claude/settings.*
.claude/scheduled_tasks.lock

# Portal audit screenshots — regenerated by tests/e2e/94, not source
tests/screenshots/

# generated by tests/audit-static.test.js
static-audit.json
